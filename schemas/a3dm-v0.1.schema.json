{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/a3-configdb/schemas/a3dm-v0.1.schema.json",
  "title": "A3DM v0.1 snapshot package",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "snapshot"],
  "properties": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "schemaVersion",
        "packageVersion",
        "datasetId",
        "snapshotId",
        "createdAt",
        "extractorVersion",
        "gameVersion",
        "presetLabel",
        "loadedAddons",
        "activeDlc",
        "artificialDataOnly",
        "sourceGameDataIncluded"
      ],
      "properties": {
        "format": { "const": "A3DM" },
        "schemaVersion": { "const": "0.1" },
        "packageVersion": { "type": "string", "minLength": 1 },
        "datasetId": { "$ref": "#/$defs/id" },
        "snapshotId": { "$ref": "#/$defs/id" },
        "createdAt": { "type": "string", "format": "date-time" },
        "extractorVersion": { "type": "string", "minLength": 1 },
        "gameVersion": { "type": "string", "minLength": 1 },
        "presetLabel": { "type": "string", "minLength": 1 },
        "loadedAddons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["order", "id", "name"],
            "properties": {
              "order": { "type": "integer", "minimum": 0 },
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": ["string", "null"] }
            }
          }
        },
        "activeDlc": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "artificialDataOnly": { "type": "boolean" },
        "sourceGameDataIncluded": { "type": "boolean" },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotId", "roots"],
      "properties": {
        "snapshotId": { "$ref": "#/$defs/id" },
        "roots": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/class" }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent", "properties"],
      "properties": {
        "parent": { "type": ["string", "null"] },
        "properties": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
